# ==============================================================================
# L2TP Web Hub — Шаблон конфигурации окружения (.env)
# Скопируйте этот файл в .env и настройте параметры под вашу инфраструктуру
# ==============================================================================

# Хост и порт для веб-панели управления
BIND_HOST=0.0.0.0
BIND_PORT=5000

# Отображаемое имя ноды в веб-интерфейсе
NODE_NAME=L2TP-Gateway-1

# Внешний публичный IP или DNS-домен сервера (используется в памятках Synology)
# Если оставить пустым, будет определен автоматически через ipify
PUBLIC_IP=10.18.9.190

# ==============================================================================
# Сетевой пул и шлюз для Synology
# ==============================================================================
# Локальный IP шлюза сервера для PPP-интерфейсов
LOCAL_TUNNEL_IP=10.18.12.1

# Диапазон статических IP-адресов, автоматически выдаваемых клиентам
IP_POOL_START=10.18.15.1
IP_POOL_END=10.18.15.254

# Общий секрет IPsec (Pre-Shared Key / PSK)
L2TP_IPSEC_PSK=L2tP(L2tB)Gbylf2019!

# ==============================================================================
# Авторизация и доступ к веб-панели (AUTH_MODE)
# ==============================================================================
# Режимы:
# standalone = Вход по локальному логину/паролю администратора
# central    = Авторизация через центральный SSO-сервер (centralized-auth / CA)
# ad         = Прямая авторизация через Active Directory / LDAP
AUTH_MODE=standalone

# ------------------------------------------------------------------------------
# 1. Параметры для AUTH_MODE=standalone
# ------------------------------------------------------------------------------
STANDALONE_ADMIN_USER=admin
STANDALONE_ADMIN_PASSWORD=admin123

# ------------------------------------------------------------------------------
# 2. Параметры для AUTH_MODE=central (Централизованная авторизация / CA)
# ------------------------------------------------------------------------------
CENTRAL_AUTH_URL=http://127.0.0.1:5001
NODE_API_TOKEN=default-token-change-me-please
VERIFY_SSL=false

# ------------------------------------------------------------------------------
# 3. Параметры для AUTH_MODE=ad (Прямой Active Directory / LDAP)
# ------------------------------------------------------------------------------
LDAP_SERVER=ldap://dc1.company.local
LDAP_PORT=389
LDAP_USE_SSL=false
LDAP_BASE_DN=DC=company,DC=local
LDAP_BIND_USER=CN=ldap_bind,OU=ServiceAccounts,DC=company,DC=local
LDAP_BIND_PASSWORD=SecretPassword123
LDAP_USER_FILTER=(&(objectClass=user)(sAMAccountName={username}))

# Список пользователей, получающих права Администратора (через запятую)
ADMIN_USERS=admin,a.ivanov,operator_lead
# Название группы администраторов из Active Directory / LDAP
ADMIN_GROUP=VPN_Admins

# Секретный ключ для подписи сессий веб-панели (сгенерируйте: openssl rand -hex 16)
SECRET_KEY=change-this-to-a-very-secret-random-key-in-production

# Каталог монтирования постоянных данных (БД, конфиги, сертификаты)
DATA_DIR=/app/data

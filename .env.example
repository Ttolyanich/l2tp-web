# ==============================================================================
# L2TP Web Hub — Шаблон конфигурации окружения (.env)
# Переименуйте этот файл в .env и настройте параметры ниже
# ==============================================================================

# Хост и порт для веб-панели управления (по умолчанию 5000)
BIND_HOST=0.0.0.0
BIND_PORT=5000

# ==============================================================================
# Настройки L2TP / IPsec сервера
# ==============================================================================
# Внешний публичный IP или DNS-хостнейм сервера (если пусто, определится автоматически)
PUBLIC_IP=

# Отображаемое имя этой ноды VPN в интерфейсе
NODE_NAME=L2TP-Gateway-1

# Локальный IP шлюза сервера для PPP-интерфейсов
LOCAL_TUNNEL_IP=10.18.12.1

# Диапазон статических IP-адресов, автоматически выдаваемых клиентам Synology
IP_POOL_START=10.18.15.1
IP_POOL_END=10.18.15.254

# Общий секрет IPsec (Pre-Shared Key / PSK)
L2TP_IPSEC_PSK=L2tP(L2tB)Gbylf2019!

# ==============================================================================
# Авторизация и доступ (скопировано с OpenVPN Web)
# ==============================================================================
# Режим авторизации:
# central    = авторизация через центральный сервер centralized-auth (SSO / CA)
# standalone = автономный запуск со своей локальной учетной записью администратора
AUTH_MODE=central

# Параметры локального администратора для автономного режима (AUTH_MODE=standalone)
STANDALONE_ADMIN_USER=admin
STANDALONE_ADMIN_PASSWORD=admin123

# Разграничение прав и роли Администраторов (RBAC):
# Список логинов/email (через запятую), которые автоматически получают права Администратора:
ADMIN_USERS=admin,operator_lead
# Название группы администраторов из центра авторизации / CA:
ADMIN_GROUP=VPN_Admins

# Секретный ключ для подписи сессий Flask (обязательно смените в продакшене)
# Для генерации случайного ключа выполните команду: openssl rand -hex 16
SECRET_KEY=default-secret-key-change-me-please

# URL-адрес Центрального сервера авторизации (centralized-auth / CA)
CENTRAL_AUTH_URL=http://host.docker.internal:5001

# Токен для авторизации ноды (должен символ-в-символ совпадать с токеном в центре авторизации)
NODE_API_TOKEN=default-token-change-me-please

# Проверка SSL-сертификата центра авторизации (false для самоподписанных сертификатов)
VERIFY_SSL=false

# Каталог для постоянных данных (БД, конфиги, chap-secrets)
DATA_DIR=/app/data
